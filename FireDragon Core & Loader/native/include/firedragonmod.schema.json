{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FireDragon mod resources",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {"const": 1},
    "name": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$", "maxLength": 128},
    "version": {"type": "integer", "minimum": 1, "maximum": 16777215, "default": 1},
    "dlls": {
      "type": "array", "maxItems": 32, "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "shaders": {
      "type": "object", "maxProperties": 128,
      "propertyNames": {"pattern": "^[A-Za-z_][A-Za-z0-9_]*$", "maxLength": 128},
      "additionalProperties": {"type": "string", "minLength": 1}
    }
  }
}
